# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.mp4
*.log
*.rar
*.zip

# Local runtime data (portable app)
/config/
/Download/
/download_cache/
/update_temp
/debug.log

# Cookies/config are local-only
*.json

# Nested vendor repos are not part of this repo
/ffmpeg-go/
/ffstatic/
/gomedia/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage toolkit, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
./config/

# Go workspace file
go.work
go.work.sum
